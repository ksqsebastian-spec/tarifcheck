{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tarifcheck",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],

  // Taeglich 06:15 UTC. Cron-Ausdruecke laufen immer in UTC.
  "triggers": {
    "crons": ["15 6 * * *"]
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Der Worker entscheidet immer zuerst.
    //
    // Bewusst pauschal und nicht als Pfadliste: sonst faengt die
    // Dateiauslieferung Pfade ab, die es als Datei nicht gibt, und antwortet
    // mit 405 statt den Worker zu fragen. Das trifft genau die Pfade der
    // MCP-Anmeldung (/mcp, /token, /register, /.well-known/...) und faellt
    // erst auf, wenn Claude sich nicht verbinden kann. Statische Dateien
    // liefert der Worker am Ende ueber env.ASSETS.fetch aus.
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tarifcheck",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "tarifcheck"
    }
  ],

  "ai": {
    "binding": "AI"
  },

  // Tokens und Grants des OAuth-Providers fuer den MCP.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "00000000000000000000000000000000"
    }
  ],

  // Selbstbindung: der Cron ruft sich hierueber einmal pro Quelle auf.
  // Laeuft am Netzwerk vorbei, also auch an Cloudflare Access vorbei.
  "services": [
    {
      "binding": "SELF",
      "service": "tarifcheck"
    }
  ],

  "observability": {
    "enabled": true
  }

  // Nur noetig, falls die 10ms Rechenzeit des Free-Plans nicht reichen.
  // Setzt Workers Paid voraus. Siehe PLAN.md Abschnitt 4.
  // "limits": { "cpu_ms": 30000 }
}
