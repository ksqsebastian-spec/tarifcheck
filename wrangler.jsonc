{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tarifcheck",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],

  // Taeglich 06:15 UTC. Cron-Ausdruecke laufen immer in UTC.
  "triggers": {
    "crons": ["15 6 * * *"]
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Der Worker entscheidet immer zuerst.
    //
    // Bewusst pauschal und nicht als Pfadliste: sonst faengt die
    // Dateiauslieferung Pfade ab, die es als Datei nicht gibt, und antwortet
    // mit 405 statt den Worker zu fragen. Das trifft genau die Pfade der
    // MCP-Anmeldung (/mcp, /token, /register, /.well-known/...) und faellt
    // erst auf, wenn Claude sich nicht verbinden kann. Statische Dateien
    // liefert der Worker am Ende ueber env.ASSETS.fetch aus.
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tarifcheck",
      "database_id": "c828eed8-fd67-4dfa-a196-6ed3fec8d640",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "tarifcheck"
    }
  ],

  "ai": {
    "binding": "AI"
  },

  // Bremse gegen das Durchprobieren von Passwoertern.
  //
  // Als Durable Object, weil es die einzige stark konsistente Zaehlstelle hier
  // ist. KV war eventual consistent und zaehlte zu spaet; der ratelimit-Binding
  // zaehlt je Instanz statt je Standort und liess einzelne Anfragen durch.
  // Beide sahen funktionsfaehig aus und waren es nicht.
  "durable_objects": {
    "bindings": [{ "name": "BREMSE", "class_name": "Bremse" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Bremse"] }
  ],

  // Tokens und Grants des OAuth-Providers fuer den MCP.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "58c20a25b82b4b3bace3ba4e0eb95ddf"
    }
  ],

  // Selbstbindung: der Cron ruft sich hierueber einmal pro Quelle auf.
  // Als RPC-Einstieg, damit der Weg ueber HTTP gar nicht erst existiert.
  "services": [
    {
      "binding": "SELF",
      "service": "tarifcheck",
      "entrypoint": "SyncEntrypoint"
    }
  ],

  // Kennung der ausgerollten Fassung.
  //
  // Damit der Deploy pruefen kann, ob wirklich die NEUE Fassung antwortet.
  // Vorher sah er nur nach, ob ueberhaupt jemand antwortet - was die vorige
  // Fassung waehrend der ein bis zwei Minuten Rollout genauso tut. Der Check
  // war damit immer gruen und sagte nichts.
  "version_metadata": { "binding": "FASSUNG" },

  "observability": {
    "enabled": true
  },

  // Setzt Workers Paid voraus (5 $/Monat).
  //
  // Noetig, weil der Text mit pdf.js gewonnen wird statt mit der
  // KI-Umwandlung: die scheiterte an drei von siebzehn Vertraegen, ohne einen
  // Fehler zu melden. pdf.js kostet dafuer Rechenzeit - der BRTV braucht rund
  // 1,3 Sekunden, das 130-fache dessen, was der kostenlose Tarif erlaubt.
  //
  // Der Wert ist die Obergrenze, nicht der Verbrauch: abgerechnet wird nur,
  // was tatsaechlich gerechnet wird, und das faellt nur an, wenn sich ein
  // Vertrag wirklich geaendert hat.
  "limits": { "cpu_ms": 120000 }
}
