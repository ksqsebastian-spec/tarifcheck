{
  "name": "tarifcheck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "gen:icons": "node scripts/gen-icons.mjs",
    "migrate:local": "wrangler d1 migrations apply tarifcheck --local",
    "migrate": "wrangler d1 migrations apply tarifcheck --remote",
    "seed:local": "node scripts/seed-sources.mjs > .seed.sql && wrangler d1 execute tarifcheck --local --file=.seed.sql",
    "seed": "node scripts/seed-sources.mjs > .seed.sql && wrangler d1 execute tarifcheck --remote --file=.seed.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.119.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.20.1",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  }
}
